# Server (server-api). Never commit real values.
NM_SECRET=change-me-to-a-random-string-of-32-or-more-characters
NM_ORIGIN=http://localhost:5173
NM_DATA=./data.json         # or ./data.sqlite for durable SQLite storage (Node 22.5+)
NM_APP_URL=http://localhost:5173   # used in email links
RESEND_API_KEY=             # optional: email verification + password reset
NM_MAIL_FROM=
NM_TRUST_PROXY=0            # set to 1 behind Render/Nginx so rate limits see the real client IP
NM_BOT_KEY=                 # 16+ chars, shared with the bot process
NM_FEE_PCT=10
# Optional online payments (Razorpay)
RZP_KEY_ID=
RZP_KEY_SECRET=
RZP_WEBHOOK_SECRET=
# Optional chat bot
NM_API=http://localhost:8787
TELEGRAM_TOKEN=
WA_TOKEN=
WA_PHONE_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
# AI keys are entered inside the app (Settings) and stay in your browser, not here.
