// Finds simulations that do not animate on their own and picks the slider whose sweep visibly changes the picture.
// Writes src/sims/sweepMap.ts.  Run: npx tsx tools/gen-sweep.mts
import fs from 'fs'; import path from 'path';
import { defaultsOf } from '../src/sims/types.ts';
let sig = ''; const noop = () => {};
const ctx: any = new Proxy({}, { get: (_t, k: string) => { if (k === 'createLinearGradient' || k === 'createRadialGradient') return () => ({ addColorStop: noop }); if (k === 'measureText') return () => ({ width: 10 }); if (k === 'canvas') return { width: 700, height: 440 }; return (...a: any[]) => { sig += String(k) + a.map(x => typeof x === 'number' ? Math.round(x * 10) / 10 : typeof x === 'string' ? x : '').join(',') + ';'; }; }, set: (_t, k, v) => { sig += String(k) + '=' + (typeof v === 'string' ? v : typeof v === 'number' ? Math.round(v * 10) / 10 : '') + ';'; return true; } });
const dir = path.resolve('src/sims'); const sims: any[] = []; const seen = new Set<string>();
for (const f of fs.readdirSync(dir)) { if (!f.endsWith('.ts') || /^(registry|types|draw|curriculumCatalog|univ_util|sweepMap)\.ts$/.test(f)) continue; const m: any = await import(path.join(dir, f)); for (const x of Object.values(m)) for (const s of (Array.isArray(x) ? x : [x]) as any[]) if (s && typeof s === 'object' && s.id && s.init && s.step && s.draw && !seen.has(s.id)) { seen.add(s.id); sims.push(s); } }
const drawSig = (sim: any, s: any, v: any) => { sig = ''; try { sim.draw(ctx, s, v, 700, 440); } catch { /* ignore */ } return sig; };
const map: Record<string, string> = {}; const none: string[] = [];
for (const sim of sims) {
  const v = defaultsOf(sim.params), s = sim.init(v), dt = sim.dt ?? 1 / 240; const a = drawSig(sim, s, v); const frames = Math.round(3 / dt); for (let i = 0; i < frames; i++) sim.step(s, v, dt);
  if (a !== drawSig(sim, s, v)) continue; // animates by itself
  let pick = ''; const nums = (sim.params as any[]).filter(p => p.kind === 'number').sort((x, y) => Number(!!x.resetOnChange) - Number(!!y.resetOnChange));
  for (const p of nums) { const lo = { ...v, [p.id]: p.min }, hi = { ...v, [p.id]: p.max }, mid = { ...v, [p.id]: (p.min + p.max) / 2 }; const s1 = sim.init(lo), s2 = sim.init(hi), s3 = sim.init(mid); const g = (st: any, vv: any) => { for (let i = 0; i < Math.min(frames, 60); i++) sim.step(st, vv, dt); return drawSig(sim, st, vv); }; const A = g(s1, lo), B = g(s2, hi), M = g(s3, mid); if (A !== B && A !== M && B !== M) { pick = p.id; break; } if (!pick && (A !== B || A !== M)) pick = p.id; }
  if (!pick && sim.actions?.length && sim.action) { const act = sim.actions.find((x: any) => !/clear|reset|new|random/i.test(x.label)) ?? sim.actions[0]; const s1 = sim.init(v); const b0 = drawSig(sim, s1, v); sim.action(s1, v, act.id); if (drawSig(sim, s1, v) !== b0) pick = 'action:' + act.id; }
  const togg = (sim.params as any[]).filter(p => p.kind === 'toggle'); if (!pick && togg.length >= 2) pick = 'toggles:' + togg.slice(0, 3).map((p: any) => p.id).join(',');
  const sels = (sim.params as any[]).filter(p => p.kind === 'select' && p.options.length > 1); if (!pick && sels.length) pick = 'select:' + sels[0].id;
  if (pick) map[sim.id] = pick; else none.push(sim.id);
}
const OVERRIDE: Record<string, string> = { 'vectors-3d-dot-cross': 'az0' }; for (const [k, v] of Object.entries(OVERRIDE)) { map[k] = v; const i = none.indexOf(k); if (i >= 0) none.splice(i, 1); }
const out = `// GENERATED by tools/gen-sweep.mts: simulations that do not move on their own. Play auto-sweeps the listed slider so the effect is visible.\nexport const SWEEP: Record<string, string> = ${JSON.stringify(map, null, 2)};\n`;
fs.writeFileSync('src/sims/sweepMap.ts', out); console.log(`${Object.keys(map).length} sweepable, ${none.length} with nothing to sweep:`, none);
