import { initialRun, reduce, httpBase, traversedEdges } from '../src/lib/clawbot/protocol';
import type { RunState, ServerEvent } from '../src/lib/clawbot/protocol';
let fail = 0; const ok = (n: string, c: boolean) => { console.log(c ? 'PASS' : 'FAIL', n); if (!c) fail++; };
const srv = (s: RunState, ev: ServerEvent, now = 1) => reduce(s, { type: 'server', ev, now });
let s = reduce(initialRun(), { type: 'ask', question: 'q', mode: 'online', now: 0 });
const seq = (n: number, e: Omit<ServerEvent, 'seq'>) => ({ ...e, seq: n }) as ServerEvent;
s = srv(s, seq(2, { event: 'run_start', run_id: 'r1', mode: 'online' }));
s = srv(s, seq(3, { event: 'node_start', node: 'parse', run_id: 'r1' }));
ok('active node tracked', s.activeNode === 'parse' && s.nodes.parse.status === 'active');
s = srv(s, seq(4, { event: 'node_end', node: 'parse', duration_ms: 12, note: 'x', run_id: 'r1' }));
s = srv(s, seq(5, { event: 'node_start', node: 'generate', run_id: 'r1' }));
s = srv(s, seq(6, { event: 'token', text: 'Hel', run_id: 'r1' })); s = srv(s, seq(7, { event: 'token', text: 'lo', run_id: 'r1' }));
ok('tokens accumulate', s.text === 'Hello' && s.tokens === 2);
s = srv(s, seq(8, { event: 'node_end', node: 'generate', duration_ms: 5, run_id: 'r1' }));
s = srv(s, seq(9, { event: 'node_start', node: 'generate', run_id: 'r1' }));
ok('second draft resets text, counts revision', s.text === '' && s.draftNo === 1 && s.nodes.generate.visits === 2);
s = srv(s, seq(11, { event: 'token', text: 'X' }));
ok('sequence gap detected', s.seqGaps === 1);
s = srv(s, seq(12, { event: 'token', text: 'ignored', run_id: 'OTHER' }));
ok('other run frames ignored', s.text === 'X');
s = srv(s, seq(13, { event: 'result', run_id: 'r1', answer: 'Final [1]', passed: true, route: 'memory', revisions: 1, sources: [{ n: 1, source: 's', score: 0.5 }, 'bad'], critique: { score: 0.9 }, error: null }));
ok('result parsed', s.phase === 'done' && s.result?.sources.length === 1 && s.text === 'Final [1]' && s.activeNode === null);
ok('edges', [...traversedEdges(s.path)].join() === 'parse>generate,generate>generate');
const lost = reduce(reduce(initialRun(), { type: 'ask', question: 'q', mode: 'offline', now: 0 }), { type: 'connection-lost', now: 5 });
ok('connection lost mid-run -> error', lost.phase === 'error' && /lost/.test(lost.error ?? ''));
ok('connection lost when idle is ignored', reduce(initialRun(), { type: 'connection-lost', now: 1 }).phase === 'idle');
ok('cancelled', srv(reduce(initialRun(), { type: 'ask', question: 'q', mode: 'online', now: 0 }), { event: 'cancelled' }).phase === 'cancelled');
ok('server error', srv(reduce(initialRun(), { type: 'ask', question: 'q', mode: 'online', now: 0 }), { event: 'error', code: 'llm', message: 'down' }).error === 'down');
ok('unknown/garbage events harmless', srv(s, { event: 'weird', seq: 14 }).phase === 'done');
ok('httpBase', httpBase('ws://127.0.0.1:8765/ws') === 'http://127.0.0.1:8765' && httpBase('wss://h.example/api/ws?x=1') === 'https://h.example/api' && httpBase('nope') === '');
console.log(fail ? `${fail} FAILED` : 'ALL PASS'); process.exit(fail ? 1 : 0);
