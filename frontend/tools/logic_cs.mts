// Behavioural checks of the CS/security simulations: npx tsx tools/logic_cs.mts
import { redBlackTree, qLearningGrid, raftConsensus, zkProof, trafficAnomaly } from '../src/sims/univ_cs_sec.ts';
import { defaultsOf } from '../src/sims/types.ts';
let fail = 0; const t = (n: string, ok: boolean, x = '') => { console.log(ok ? 'ok  ' : 'FAIL', n, ok ? '' : x); if (!ok) fail++; };
const run = (sim: any, over: Record<string, any>, secs: number) => { const v = { ...defaultsOf(sim.params), ...over }; const s = sim.init(v); for (let i = 0; i < secs / sim.dt; i++) sim.step(s, v, sim.dt); return { s, v }; };
for (const order of ['asc', 'desc', 'rand']) for (const n of [3, 15, 31]) { const { s, v } = run(redBlackTree, { order, n, gap: 0.1 }, n * 0.1 + 2); const r = redBlackTree.readouts(s, v); t(`RB ${order} n=${n}`, r.find((x: any) => x.label === 'Valid red-black tree')!.value === 'yes' && s.n === n && (r.find((x: any) => x.label === 'Height')!.value as number) <= 2 * Math.log2(n + 1) + 1e-9); }
{ const { s, v } = run(redBlackTree, { order: 'rand', n: 10, gap: 0.1 }, 3); for (let i = 0; i < 40; i++) redBlackTree.action!(s, v, 'extra'); t('RB extra keys valid', redBlackTree.readouts(s, v).find((x: any) => x.label === 'Valid red-black tree')!.value === 'yes'); }
{ const { s, v } = run(qLearningGrid, { algo: 'q', env: 'cliff', eps: 0.1, spf: 200 }, 40); const avg = qLearningGrid.readouts(s, v)[2].value as number; t('Q-learning learns (avg return > -60)', avg > -60, String(avg)); const q2 = run(qLearningGrid, { algo: 'sarsa', env: 'cliff', eps: 0.1, spf: 200 }, 40); t('SARSA learns', (qLearningGrid.readouts(q2.s, q2.v)[2].value as number) > -60); const o = run(qLearningGrid, { env: 'open', eps: 0.2, spf: 200 }, 20); t('open grid finite', Number.isFinite(qLearningGrid.readouts(o.s, o.v)[2].value as number)); }
{ const { s, v } = run(raftConsensus, { ts: 1 }, 15); const g = (k: string) => raftConsensus.readouts(s, v).find((x: any) => x.label === k)!.value; t('Raft elects a leader', String(g('Leader')).startsWith('N'), String(g('Leader')));
  raftConsensus.action!(s, v, 'write'); raftConsensus.action!(s, v, 'write'); for (let i = 0; i < 120; i++) raftConsensus.step(s, v, raftConsensus.dt!); t('Raft commits writes', (g('Highest commit index') as number) >= 2, String(g('Highest commit index')));
  const l1 = g('Leader'); raftConsensus.action!(s, v, 'kill'); for (let i = 0; i < 300; i++) raftConsensus.step(s, v, raftConsensus.dt!); t('Raft re-elects after kill', String(g('Leader')).startsWith('N') && g('Leader') !== l1, `${l1} -> ${g('Leader')}`);
  t('Raft prefixes agree', g('Committed prefixes agree') === 'yes');
  for (const nd of s.nodes.slice(0, 3)) nd.alive = false; for (let i = 0; i < 300; i++) raftConsensus.step(s, v, raftConsensus.dt!); raftConsensus.action!(s, v, 'write'); const c0 = g('Highest commit index'); for (let i = 0; i < 200; i++) raftConsensus.step(s, v, raftConsensus.dt!); t('No commit without quorum', g('Highest commit index') === c0 && !String(g('Nodes alive')).includes('undefined'));
  raftConsensus.action!(s, v, 'revive'); for (let i = 0; i < 600; i++) raftConsensus.step(s, v, raftConsensus.dt!); t('Recovers after revive', String(g('Leader')).startsWith('N') && g('Committed prefixes agree') === 'yes'); }
{ const h = run(zkProof, { cheat: false, rate: 20 }, 30); t('ZK honest never rejected', zkProof.readouts(h.s, h.v)[1].value === 'accepting'); const c = run(zkProof, { cheat: true, rate: 20 }, 30); t('ZK cheater caught', zkProof.readouts(c.s, c.v)[1].value === 'REJECT'); }
{ const { s, v } = run(trafficAnomaly, { thr: 4, int: 4 }, 400); const r = trafficAnomaly.readouts(s, v); t('IDS detects attacks (TPR>60%)', (r[0].value as number) > 60, String(r[0].value)); t('IDS low FPR (<5%)', (r[1].value as number) < 5, String(r[1].value)); }
console.log(fail ? `${fail} FAILED` : 'ALL PASS'); process.exit(fail ? 1 : 0);
